# Copy to .env.local and fill in from Supabase → Project Settings → API (choose an EU region project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, server only (never NEXT_PUBLIC_): lets new family members sign up with email + password
# without a confirmation email, even while "Confirm email" is on in Supabase.
# Supabase → Project Settings → API Keys → service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Google Client ID (same as in Supabase → Auth → Google). Enables the in-page Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
